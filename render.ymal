services:
  - type: web
    name: calgarycommunity-django
    env: python
    plan: free
    buildCommand: >
      pip install --upgrade pip &&
      pip install wheel &&
      pip install -r requirements.txt
    pythonVersion: 3.11.8
    startCommand: "gunicorn calCrimes.wsgi"
    envVars:
      - key: DEBUG
        value: False
      - key: SECRET_KEY
        generateValue: true
      - key: DB_NAME
        fromDatabase:
          name: your-db-name
          property: database
      - key: DB_USER
        fromDatabase:
          name: your-db-name
          property: user
      - key: DB_PASSWORD
        fromDatabase:
          name: your-db-name
          property: password
      - key: DB_HOST
        fromDatabase:
          name: your-db-name
          property: host
      - key: DB_PORT
        fromDatabase:
          name: your-db-name
          property: port